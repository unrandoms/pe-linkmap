cmake_minimum_required(VERSION 3.16)
project({{ dll_name | replace(".dll", "") | replace(".DLL", "") }}_proxy
        LANGUAGES C
        VERSION 1.0.0)

# ---------------------------------------------------------------------------
# Target: proxy DLL
# ---------------------------------------------------------------------------
add_library(proxy SHARED
    proxy.c
)

set_target_properties(proxy PROPERTIES
    OUTPUT_NAME "{{ dll_name | replace(".dll", "") | replace(".DLL", "") }}"
    PREFIX      ""   # suppress lib prefix on MinGW
    SUFFIX      ".dll"
)

# Link options: treat the .def file as the export map
if(MSVC)
    target_link_options(proxy PRIVATE
        "/DEF:${CMAKE_CURRENT_SOURCE_DIR}/proxy.def"
    )
else()
    # MinGW / GCC
    target_link_options(proxy PRIVATE
        "-Wl,--kill-at"
        "-Wl,--output-def,proxy.def"
    )
endif()

target_compile_definitions(proxy PRIVATE
    UNICODE
    _UNICODE
    WIN32_LEAN_AND_MEAN
)

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------
install(TARGETS proxy
        RUNTIME DESTINATION .)

# ---------------------------------------------------------------------------
# Usage reminder
# ---------------------------------------------------------------------------
message(STATUS "-------------------------------------------------------------")
message(STATUS "Proxy target: {{ dll_name }}")
message(STATUS "Original DLL must be renamed to: {{ orig_stem }}.dll")
message(STATUS "")
message(STATUS "Build (Release x64 MSVC):")
message(STATUS "  cmake -B build -G \"Visual Studio 17 2022\" -A x64")
message(STATUS "  cmake --build build --config Release")
message(STATUS "")
message(STATUS "Build (Release x64 MinGW):")
message(STATUS "  cmake -B build -G \"MinGW Makefiles\" -DCMAKE_BUILD_TYPE=Release")
message(STATUS "  cmake --build build")
message(STATUS "-------------------------------------------------------------")
